@startuml diagrama_venta

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

package "Adaptadores (Exterior)" {
    class InMemoryVentaRepository
}

package "Núcleo de la Aplicación" {
    package "Puertos" {
        interface ConfirmarVentaUseCase
        interface VentaRepository
    }

    package "Servicios (Casos de Uso)" {
        class ConfirmarVentaService
    }

    package "Dominio" {
        class Venta {
            -estado: EstadoVenta
            +setEstado(estado: EstadoVenta): void
        }
    }
}

' Relaciones de Arquitectura Hexagonal
ConfirmarVentaUseCase <|.. ConfirmarVentaService : "Implementa (Puerto Entrada)"
ConfirmarVentaService ..> Venta : "Modifica estado"
ConfirmarVentaService --> VentaRepository : "Usa (Puerto Salida)"
VentaRepository <|.. InMemoryVentaRepository : "Depende de (Inversión de Dependencia)"

@enduml
