@startuml diagrama_venta

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

class Producto {
  -codigo: long
  -nombre: String
  -precio: double
  -existencia: int
  +descontar(cantidad: int): void
}

class Venta {
  -detalles: List<DetalleVenta>
  +agregarDetalle(producto: Producto, cantidad: int): void
  +calcularTotal(): double
}

class DetalleVenta {
  -producto: Producto
  -cantidad: int
  -precioCapturado: double
  +subtotal(): double
}

Venta "1" *-- "1..*" DetalleVenta : contiene
DetalleVenta --> "1" Producto : referencia

note right of DetalleVenta
  precioCapturado se copia al
  agregar el detalle; no cambia
  aunque después cambie el
  precio del catálogo.
end note

note right of Venta
  detalles nunca se expone
  directamente; solo se
  modifica vía agregarDetalle().
end note

@enduml
