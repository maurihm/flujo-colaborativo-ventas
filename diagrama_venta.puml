@startuml diagrama_venta

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

package "Exterior (Adaptadores)" {
    class InMemoryVentaRepository
    class TestAutomatizado
}

package "Núcleo (Dominio y Aplicación)" {
    
    package "Aplicación" {
        interface RegistrarVentaUseCase
        class RegistrarVentaService
    }

    package "Dominio" {
        interface VentaRepository
        
        class Producto {
          -codigo: long
          -nombre: String
          -precio: double
          -existencia: int
          +descontar(cantidad: int): void
        }

        class Venta {
          -detalles: List<DetalleVenta>
          +agregarDetalle(producto: Producto, cantidad: int): void
          +calcularTotal(): double
        }

        class DetalleVenta {
          -producto: Producto
          -cantidad: int
          -precioCapturado: double
          +subtotal(): double
        }
    }
}

' Relaciones del Dominio Original
Venta "1" *-- "1..*" DetalleVenta : contiene
DetalleVenta --> "1" Producto : referencia

' Relaciones de Arquitectura Hexagonal
TestAutomatizado ..> RegistrarVentaUseCase : "Actor principal"
RegistrarVentaUseCase <|.. RegistrarVentaService : "Implementa"
RegistrarVentaService ..> Venta : "Coordina"
RegistrarVentaService --> VentaRepository : "Usa (Puerto de salida)"
VentaRepository <|.. InMemoryVentaRepository : "Invierte dependencia"

note right of DetalleVenta
  precioCapturado se copia al
  agregar el detalle; no cambia
  aunque después cambie el
  precio del catálogo.
end note

@enduml