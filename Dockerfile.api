FROM eclipse-temurin:11-jdk-alpine AS build
RUN apk add --no-cache maven
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B package -Dmaven.test.skip=true -Djacoco.skip=true

FROM eclipse-temurin:11-jre-alpine
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=build /build/target/ventas-tcsw-*.jar /app/ventas-tcsw.jar
USER appuser
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/ventas-tcsw.jar"]
